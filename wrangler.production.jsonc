{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panigale-group-crm",
  "main": "./worker-entry.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client" },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    { "pattern": "crm.panigale.tech", "custom_domain": true, "zone_name": "panigale.tech", "enabled": true, "previews_enabled": false }
  ],
  "d1_databases": [
    {
      "binding": "CRM_DB",
      "database_name": "panigale-group-crm-production",
      "database_id": "5f90c9cc-24e5-4e85-b9e9-8446d7a8fd5b",
      "migrations_dir": "crm-migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "CRM_DOCUMENTS", "bucket_name": "panigale-group-crm-documents-production" }
  ],
  "send_email": [
    { "name": "CRM_EMAIL", "remote": true, "allowed_sender_addresses": ["panipay@panigale.tech", "euroza@panigale.tech"] }
  ],
  "vars": {
    "CRM_PUBLIC_URL": "https://crm.panigale.tech",
    "AUTH_ISSUER": "https://auth.panigale.tech",
    "PANIGALE_AUTH_CLIENT_ID": "pg_ad413e72881fcd82d923e8e9bdd4f6af",
    "CRM_AI_ENABLED": "false",
    "CRM_AI_MODEL": "@cf/openai/gpt-oss-20b",
    "CRM_EMAIL_SEND_ENABLED": "false",
    "CRM_READ_ONLY_MODE": "false",
    "CRM_SCHEDULED_JOBS_ENABLED": "true"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
